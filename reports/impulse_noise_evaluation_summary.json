  "candidate_estimator": {
    "formula": "impulse_fraction = count of extreme (0 or 255) pixels with absolute residual from a 3x3 median filter >= 64, divided by total pixel count",
    "kernel_size": 3,
    "residual_threshold": 64.0,
    "initial_fixed_detection_threshold": 0.005,
    "rationale": "Investigates isolated saturated impulses while requiring a large local residual. Performance on blur, contrast, and the clean source must be judged from measured false positives.",
    "experimental_fuzzy_controller": {
      "input": "candidate_impulse_fraction",
      "input_range": [
        0.0,
        1.0
      ],
      "membership_functions": {
        "low": "trapmf([0, 0, 0.0025, 0.005])",
        "medium": "trimf([0.0025, 0.005, 0.0083])",
        "high": "trapmf([0.005, 0.0083, 1, 1])"
      },
      "rules": [
        "blur low -> poor",
        "contrast low -> poor",
        "impulse fraction high -> poor",
        "blur medium AND contrast medium AND impulse medium -> fair",
        "blur high AND contrast medium AND impulse low -> good",
        "blur high AND contrast high AND impulse low -> good",
        "blur medium AND contrast high AND impulse low -> good"
      ],
      "state_thresholds_unchanged": {
        "ACCEPT": "score >= 75",
        "BORDERLINE": "45 <= score < 75",
        "REJECT": "score < 45"
      },
      "limitations": "Separate experimental controller; its scores are not directly comparable as calibrated quality scores with the baseline controller."
    },
    "threshold_selection": {
      "fixed_threshold": {
        "impulse_fraction": 0.005,
        "percent": 0.5,
        "selection_basis": "Initial engineering cutoff specified for the exploratory evaluation; not selected by maximizing the threshold-sweep F1.",
        "optimized_on_this_dataset": false
      },
      "best_f1_in_sample": {
        "impulse_fraction": 0.00830078125,
        "percent": 0.830078125,
        "selection_objective": "Maximize F1; ties are resolved by precision and then the larger threshold.",
        "selected_and_evaluated_on_same_101_images": true,
        "held_out_performance_estimate": false
      }
    }
  },
